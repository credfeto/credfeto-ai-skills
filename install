#!/bin/sh
# Installs every skill and then every agent into ~/.claude, or with --system
# into the managed Claude Code folder /etc/claude-code/.claude using sudo.
# Skills go first because agents preload them by name.

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

SYSTEM_FLAG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --system)
            SYSTEM_FLAG="--system"
            ;;
        *)
            die "unknown argument: $1 (usage: install [--system])"
            ;;
    esac
    shift
done

REPO_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
[ -n "${REPO_ROOT}" ] || die "could not determine the repository root"

info "Installing skills..."
"${REPO_ROOT}/ai/skills/install" ${SYSTEM_FLAG:+"${SYSTEM_FLAG}"} || die "skill installation failed"

info "Installing agents..."
"${REPO_ROOT}/ai/agents/install" ${SYSTEM_FLAG:+"${SYSTEM_FLAG}"} || die "agent installation failed"

success "Installed skills and agents"
