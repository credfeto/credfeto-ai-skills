#!/bin/sh
# Installs each agent in this folder into ~/.claude/agents as credfeto-<agent>.md
# so Claude Code can discover them as personal agents, or with --system into
# /etc/claude-code/.claude/agents using sudo so they are managed agents for every user.

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

SYSTEM=""

while [ $# -gt 0 ]; do
    case "$1" in
        --system)
            SYSTEM="yes"
            ;;
        *)
            die "unknown argument: $1 (usage: install [--system])"
            ;;
    esac
    shift
done

SUDO=""

if [ -n "${SYSTEM}" ] && [ "$(id -u)" -ne 0 ]; then
    command -v sudo > /dev/null 2>&1 || die "--system needs root or sudo on PATH"
    SUDO="sudo"
fi

run() { ${SUDO:+"${SUDO}"} "$@"; }

# Root's umask may leave system copies unreadable to the users who load them.
make_world_readable() {
    [ -n "${SYSTEM}" ] || return 0
    run chmod "$@"
}

AGENTS_SOURCE_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
[ -n "${AGENTS_SOURCE_DIR}" ] || die "could not determine the agents source directory"

MANAGED_ROOT="/etc/claude-code"

if [ -n "${SYSTEM}" ]; then
    TARGET_ROOT="${MANAGED_ROOT}/.claude/agents"
else
    TARGET_ROOT="${HOME}/.claude/agents"
fi

MANIFEST="${TARGET_ROOT}/.credfeto-ai-skills-agents"

# An admin may have locked an existing /etc/claude-code down on purpose, so only folders this run creates are widened.
# The test runs through sudo because this user may not be able to see inside a locked-down managed root.
if [ -n "${SYSTEM}" ]; then
    set --
    for new_dir in "${MANAGED_ROOT}" "${MANAGED_ROOT}/.claude" "${TARGET_ROOT}"; do
        run test -d "${new_dir}" || set -- "$@" "${new_dir}"
    done
fi

run mkdir -p "${TARGET_ROOT}" || die "could not create ${TARGET_ROOT}"

# Users must be able to traverse every folder mkdir -p created, including the managed root above .claude.
if [ -n "${SYSTEM}" ] && [ "$#" -gt 0 ]; then
    make_world_readable a+rX "$@" || die "could not make $* world-readable"
fi

NEW_MANIFEST="${MANIFEST}.new"

# sudo does not raise the privilege of a shell redirection, so the system manifest is built where this user can write.
if [ -n "${SYSTEM}" ]; then
    MANIFEST_DRAFT=$(mktemp) || die "could not create a temporary manifest"
    trap 'rm -f "${MANIFEST_DRAFT}"' EXIT
    trap 'exit 1' HUP INT TERM
else
    MANIFEST_DRAFT="${NEW_MANIFEST}"
fi

PREVIOUS_MANIFEST=""

# A failed read must stop the run, or stale agents would be kept and then dropped from the new manifest.
# The test runs through sudo because this user may not be able to see inside a locked-down managed root.
if run test -f "${MANIFEST}"; then
    PREVIOUS_MANIFEST=$(run cat "${MANIFEST}") || die "could not read ${MANIFEST}"
fi
: > "${MANIFEST_DRAFT}" || die "could not write ${MANIFEST_DRAFT}"

INSTALLED=0

for agent_dir in "${AGENTS_SOURCE_DIR}"/*/; do
    [ -d "${agent_dir}" ] || continue

    agent_name=$(basename "${agent_dir}")

    [ -f "${agent_dir}AGENT.md" ] || {
        info "Skipping ${agent_name}: no AGENT.md found"
        continue
    }

    target_file="${TARGET_ROOT}/credfeto-${agent_name}.md"

    info "Installing ${agent_name} as credfeto-${agent_name}..."

    run cp "${agent_dir}AGENT.md" "${target_file}" || die "could not copy ${agent_name} to ${target_file}"
    make_world_readable a+r "${target_file}" || die "could not make ${target_file} world-readable"
    printf '%s\n' "${agent_name}" >> "${MANIFEST_DRAFT}" || die "could not write ${MANIFEST_DRAFT}"

    INSTALLED=$((INSTALLED + 1))
done

[ "${INSTALLED}" -gt 0 ] || die "no agents found to install in ${AGENTS_SOURCE_DIR}"

# Only agents this installer put there before are removed, so other credfeto-* agents are left alone.
for previous_name in ${PREVIOUS_MANIFEST}; do
    [ -f "${AGENTS_SOURCE_DIR}/${previous_name}/AGENT.md" ] && continue

    info "Removing stale credfeto-${previous_name}: no longer in ${AGENTS_SOURCE_DIR}"
    run rm -f "${TARGET_ROOT}/credfeto-${previous_name}.md" || die "could not remove credfeto-${previous_name}.md"
done

if [ -n "${SYSTEM}" ]; then
    run cp "${MANIFEST_DRAFT}" "${NEW_MANIFEST}" || die "could not write ${NEW_MANIFEST}"
    make_world_readable a+r "${NEW_MANIFEST}" || die "could not make ${NEW_MANIFEST} world-readable"
fi

# Replaced only after a complete run, so a failed run keeps the previous record.
run mv "${NEW_MANIFEST}" "${MANIFEST}" || die "could not update ${MANIFEST}"

success "Installed ${INSTALLED} agent(s) to ${TARGET_ROOT}"
