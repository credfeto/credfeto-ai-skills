#!/bin/sh
# Installs every skill and then every agent into ~/.claude.
# Skills go first because agents preload them by name.

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

REPO_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
[ -n "${REPO_ROOT}" ] || die "could not determine the repository root"

info "Installing skills..."
"${REPO_ROOT}/ai/skills/install" || die "skill installation failed"

info "Installing agents..."
"${REPO_ROOT}/ai/agents/install" || die "agent installation failed"

success "Installed skills and agents"
