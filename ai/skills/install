#!/bin/sh
# Installs each skill in this folder into ~/.claude/skills as credfeto-<skill>
# so Claude Code can discover them as personal skills, or with --system into
# /etc/claude-code/.claude/skills using sudo so they are managed skills for every user.

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

SYSTEM=""

while [ $# -gt 0 ]; do
    case "$1" in
        --system)
            SYSTEM="yes"
            ;;
        *)
            die "unknown argument: $1 (usage: install [--system])"
            ;;
    esac
    shift
done

SUDO=""

if [ -n "${SYSTEM}" ] && [ "$(id -u)" -ne 0 ]; then
    command -v sudo > /dev/null 2>&1 || die "--system needs root or sudo on PATH"
    SUDO="sudo"
    # Checked once up front so a user without sudo rights gets a clear error; where sudo caches credentials, this also saves prompts on the later run calls.
    sudo -v || die "--system needs sudo rights"
fi

run() { ${SUDO:+"${SUDO}"} "$@"; }

# Root's umask may leave system copies unreadable to the users who load them.
make_world_readable() {
    [ -n "${SYSTEM}" ] || return 0
    run chmod "$@"
}

SKILLS_SOURCE_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
[ -n "${SKILLS_SOURCE_DIR}" ] || die "could not determine the skills source directory"

MANAGED_ROOT="/etc/claude-code"

if [ -n "${SYSTEM}" ]; then
    TARGET_ROOT="${MANAGED_ROOT}/.claude/skills"
else
    TARGET_ROOT="${HOME}/.claude/skills"
fi

MANIFEST="${TARGET_ROOT}/.credfeto-ai-skills-skills"

# .claude and the target folder only hold managed copies every user loads, so they are always widened.
# Widening them on every run also repairs folders an interrupted earlier run left at root's umask.
# An admin may have locked an existing /etc/claude-code down on purpose, so it is widened only if this run creates it.
# Seeing whether it exists needs only search permission on /etc, which every user has, so the test skips sudo.
# A failed sudo call therefore cannot make a locked, existing managed root look new.
if [ -n "${SYSTEM}" ]; then
    set -- "${MANAGED_ROOT}/.claude" "${TARGET_ROOT}"
    [ -d "${MANAGED_ROOT}" ] || set -- "${MANAGED_ROOT}" "$@"
fi

run mkdir -p "${TARGET_ROOT}" || die "could not create ${TARGET_ROOT}"

if [ -n "${SYSTEM}" ]; then
    make_world_readable a+rX "$@" || die "could not make $* world-readable"
fi

NEW_MANIFEST="${MANIFEST}.new"
MANIFEST_DRAFT=""
WORK_DIR=""
target_dir=""

# The previous copy is only deleted once it is known to be put back, so a failed restore never loses it.
restore_interrupted_install() {
    [ -n "${WORK_DIR}" ] || return 0
    if run test -e "${WORK_DIR}/old" && ! run test -e "${target_dir}"; then
        run mv "${WORK_DIR}/old" "${target_dir}" || return 1
    fi
    run rm -rf "${WORK_DIR}"
}

cleanup() {
    restore_interrupted_install
    [ -z "${MANIFEST_DRAFT}" ] || rm -f "${MANIFEST_DRAFT}"
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# sudo does not raise the privilege of a shell redirection, so the system manifest is built where this user can write.
if [ -n "${SYSTEM}" ]; then
    MANIFEST_DRAFT=$(mktemp) || die "could not create a temporary manifest"
else
    MANIFEST_DRAFT="${NEW_MANIFEST}"
fi

PREVIOUS_MANIFEST=""

# A failed read must stop the run, or stale skills would be kept and then dropped from the new manifest.
# The test runs through sudo because this user may not be able to see inside a locked-down managed root.
if run test -f "${MANIFEST}"; then
    PREVIOUS_MANIFEST=$(run cat "${MANIFEST}") || die "could not read ${MANIFEST}"
fi
: > "${MANIFEST_DRAFT}" || die "could not write ${MANIFEST_DRAFT}"

INSTALLED=0

for skill_dir in "${SKILLS_SOURCE_DIR}"/*/; do
    [ -d "${skill_dir}" ] || continue

    skill_name=$(basename "${skill_dir}")

    [ -f "${skill_dir}SKILL.md" ] || {
        info "Skipping ${skill_name}: no SKILL.md found"
        continue
    }

    target_dir="${TARGET_ROOT}/credfeto-${skill_name}"

    info "Installing ${skill_name} as credfeto-${skill_name}..."

    # Staged beside the target so both moves are same-filesystem renames; the EXIT trap puts the old copy back on failure.
    WORK_DIR=$(run mktemp -d "${TARGET_ROOT}/.credfeto-${skill_name}.XXXXXX") || die "could not create a staging folder in ${TARGET_ROOT}"
    run mkdir "${WORK_DIR}/new" || die "could not create ${WORK_DIR}/new"
    run cp -R "${skill_dir}." "${WORK_DIR}/new/" || die "could not copy ${skill_name} to ${WORK_DIR}/new"
    make_world_readable -R a+rX "${WORK_DIR}/new" || die "could not make ${WORK_DIR}/new world-readable"

    if run test -e "${target_dir}"; then
        run mv "${target_dir}" "${WORK_DIR}/old" || die "could not move aside existing ${target_dir}"
    fi
    run mv "${WORK_DIR}/new" "${target_dir}" || die "could not move ${skill_name} into ${target_dir}"
    run rm -rf "${WORK_DIR}" || die "could not remove ${WORK_DIR}"
    WORK_DIR=""

    printf '%s\n' "${skill_name}" >> "${MANIFEST_DRAFT}" || die "could not write ${MANIFEST_DRAFT}"

    INSTALLED=$((INSTALLED + 1))
done

[ "${INSTALLED}" -gt 0 ] || die "no skills found to install in ${SKILLS_SOURCE_DIR}"

# Only skills this installer put there before are removed, so other credfeto-* skills are left alone.
for previous_name in ${PREVIOUS_MANIFEST}; do
    [ -f "${SKILLS_SOURCE_DIR}/${previous_name}/SKILL.md" ] && continue

    info "Removing stale credfeto-${previous_name}: no longer in ${SKILLS_SOURCE_DIR}"
    run rm -rf "${TARGET_ROOT}/credfeto-${previous_name}" || die "could not remove credfeto-${previous_name}"
done

if [ -n "${SYSTEM}" ]; then
    run cp "${MANIFEST_DRAFT}" "${NEW_MANIFEST}" || die "could not write ${NEW_MANIFEST}"
    make_world_readable a+r "${NEW_MANIFEST}" || die "could not make ${NEW_MANIFEST} world-readable"
fi

# Replaced only after a complete run, so a failed run keeps the previous record.
run mv "${NEW_MANIFEST}" "${MANIFEST}" || die "could not update ${MANIFEST}"

success "Installed ${INSTALLED} skill(s) to ${TARGET_ROOT}"
